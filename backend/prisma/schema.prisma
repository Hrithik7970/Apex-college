// Prisma Schema for Apex College Student Management System (PostgreSQL)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Student {
  id             String            @id @default(uuid())
  name           String
  rollNumber     String            @unique
  email          String            @unique
  department     String
  year           Int               @default(1)
  semester       Int               @default(1)
  cgpa           Float             @default(0.0)
  attendance     Int               @default(0)
  feeStatus      String            @default("Pending") // "Paid", "Pending", "Overdue"
  feeAmount      Int               @default(0)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  
  courses        StudentCourse[]
  documents      StudentDocument[]
  attendanceLogs AttendanceLog[]
}

model StudentCourse {
  id         String   @id @default(uuid())
  studentId  String
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseName String
}

model StudentDocument {
  id        String   @id @default(uuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  name      String
  status    String   @default("Pending") // "Submitted", "Verified", "Rejected", "Pending"
}

model AttendanceLog {
  id        String   @id @default(uuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  date      String
  course    String
  status    String   // "Present", "Absent", "Late"
}

model PendingApproval {
  id          String   @id @default(uuid())
  name        String
  email       String   @unique
  department  String
  desiredRole String
  createdAt   DateTime @default(now())
}

model Announcement {
  id        String   @id @default(uuid())
  title     String
  content   String   @db.Text
  priority  String   @default("Normal") // "Normal", "High", "Urgent"
  author    String   @default("College Administration")
  date      String
  createdAt DateTime @default(now())
}

model Complaint {
  id          String   @id @default(uuid())
  studentId   String
  studentName String
  studentRoll String
  department  String
  subject     String
  description String   @db.Text
  status      String   @default("Pending") // "Pending", "Resolved"
  resolution  String?  @db.Text
  date        String
  createdAt   DateTime @default(now())
}

model UserRole {
  id        String   @id @default(uuid())
  email     String   @unique
  role      String   // "admin", "professor", "registrar", "student", "pending"
  createdAt DateTime @default(now())
}
